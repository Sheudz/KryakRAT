<Page
    x:Class="KryakApp.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="22" Spacing="18">

            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

            <TextBlock Text="Appearance &amp; behavior"
                       FontWeight="SemiBold"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="16" MinHeight="66" MaxWidth="1000">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme" FontSize="14"/>
                        <TextBlock Text="Select which app theme to display" FontSize="12" Opacity="0.75"/>
                    </StackPanel>

                    <ComboBox x:Name="ThemeComboBox" Grid.Column="2" Width="120" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="System"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="16" MinHeight="66" MaxWidth="1000">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE8A0;" FontSize="20" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Navigation style" FontSize="14"/>
                    </StackPanel>

                    <ComboBox x:Name="NavigationStyleComboBox" Grid.Column="2" Width="120" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="NavigationStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Left"/>
                        <ComboBoxItem Content="Top"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="16" MinHeight="66" MaxWidth="1000">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE8D6;" FontSize="20" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Sound" FontSize="14"/>
                        <TextBlock Text="Controls provide audible feedback" FontSize="12" Opacity="0.75"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="SoundStateText" Text="Off" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="SoundToggle" OffContent=""
                                      OnContent=""
                                      IsOn="False"
                                      MinWidth="0" Toggled="SoundToggle_Toggled"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="16" MinHeight="66" MaxWidth="1000">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE946;" FontSize="20" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="KryakApp" FontSize="14"/>
                        <TextBlock Text="© 2026 KryakApp. All rights reserved." FontSize="12" Opacity="0.75"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="1.0.0"
                               VerticalAlignment="Center"
                               Opacity="0.85"/>

                    <FontIcon Grid.Column="3"
                              Glyph="&#xE70D;"
                              FontSize="12"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>