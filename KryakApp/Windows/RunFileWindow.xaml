<Window
    x:Class="KryakApp.Windows.RunFileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Run File">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TitleBar x:Name="WindowTitleBar"
                  Grid.Row="0"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False"/>

        <Grid Grid.Row="1" Padding="22">
            <Pivot>
                <PivotItem Header="Upload">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Text="Select an executable file to upload and run on the remote client."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button x:Name="SelectFileButton"
                                    Content="Browse..."
                                    MinWidth="120"
                                    Click="SelectFileButton_Click"/>
                            <TextBox x:Name="FilePathTextBox"
                                     IsReadOnly="True"
                                     PlaceholderText="No file selected"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            <TextBox x:Name="UploadFileNameTextBox"
                                     PlaceholderText="Remote file name (optional)"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            <TextBox x:Name="UploadPathTextBox"
                                     Text="%TEMP%"
                                     PlaceholderText="Remote path"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                        </StackPanel>

                        <Button x:Name="RunButton"
                                Grid.Row="1"
                                Content="Upload and run"
                                IsEnabled="False"
                                MinWidth="160"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="RunButton_Click"/>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Download">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Text="Download a file from a URL and run it on the remote client."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="UrlTextBox"
                                     PlaceholderText="https://example.com/file.exe"
                                     TextChanged="UrlTextBox_TextChanged"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            <TextBox x:Name="FileNameTextBox"
                                     PlaceholderText="File name (optional)"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            <TextBox x:Name="DownloadPathTextBox"
                                     Text="%TEMP%"
                                     PlaceholderText="Remote path"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                        </StackPanel>

                        <Button x:Name="DownloadButton"
                                Grid.Row="1"
                                Content="Download and run"
                                IsEnabled="False"
                                MinWidth="160"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="DownloadButton_Click"/>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Script">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Text="Write or paste a script to execute on the remote client."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="ScriptTypeCombo"
                                      SelectedIndex="0"
                                      MinWidth="140">
                                <ComboBoxItem Content="BAT"/>
                                <ComboBoxItem Content="VBS"/>
                                <ComboBoxItem Content="PowerShell"/>
                            </ComboBox>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="ScriptTextBox"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas"
                                         MinHeight="120"/>
                            </ScrollViewer>
                        </Border>

                        <Button x:Name="ScriptRunButton"
                                Grid.Row="2"
                                Content="Run script"
                                MinWidth="140"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ScriptRunButton_Click"/>
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Window>
